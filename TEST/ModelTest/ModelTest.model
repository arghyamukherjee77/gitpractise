            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Log in to the Maximo Manage application."/>
                    <focus-ctd-template text="Navigate to the Assets application."/>
                    <focus-ctd-template text="Click the New Asset icon to create a new asset."/>
                    <focus-ctd-template text="In the Asset Description field, type &quot;anytext&quot;."/>
                    <focus-ctd-template text="In the Rotating Item field, type &quot;invaliditem&quot;."/>
                    <focus-ctd-template text="In the Status field, select &quot;decommissioned&quot;."/>
                    <focus-ctd-template text="In the Depreciation Schedule field, select &quot;doubledeclining&quot;."/>
                    <focus-ctd-template text="In the Depreciation Method field, type &quot;invalid&quot;."/>
                    <focus-ctd-template text="Click Save Asset."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The system displays the asset creation page with the entered details."/>
                    <focus-ctd-template text="The system displays an error message indicating that the rotating item is invalid."/>
                    <focus-ctd-template text="The system displays an error message indicating that the depreciation method is invalid."/>
                    <focus-ctd-template text="The asset is not saved due to the invalid rotating item and depreciation method."/>
                    <focus-ctd-template text="The system prevents the status from being changed to &quot;decommissioned&quot; because the asset has invalid attributes."/>
                    <focus-ctd-template text="The system displays a relevant error message related to the asset status change."/>
                    <focus-ctd-template text="The system displays an error message indicating that the asset cannot be saved."/>
                    <focus-ctd-template text="The system remains on the asset creation page."/>
                    <focus-ctd-template text="The system highlights the fields with invalid data."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>
            </focus-ctd-multiple-template>
