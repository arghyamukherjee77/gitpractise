                    <focus-ctd-template text="Log in to the Assets application."/>
                    <focus-ctd-template text="Click the New Asset icon on the toolbar."/>
                    <focus-ctd-template text="Enter &quot;anytext&quot; in the Asset Description field."/>
                    <focus-ctd-template text="Select &quot;no&quot; in the Rotating Item field."/>
                    <focus-ctd-template text="Enter &quot;anyasset&quot; in the Parent field."/>
                    <focus-ctd-template text="Select &quot;doubledeclining&quot; in the Depreciation Schedule field."/>
                    <focus-ctd-template text="Select &quot;meter&quot; in the Period Type field."/>
                    <focus-ctd-template text="Enter &quot;invaliduser&quot; in the Associated Users field."/>
                    <focus-ctd-template text="Enter &quot;invalidcustodian&quot; in the Associated Custodians field."/>
                    <focus-ctd-template text="Select &quot;decommissioned&quot; in the New Status field."/>
                    <focus-ctd-template text="Enter &quot;invalidasset&quot; in the To Parent field."/>
                    <focus-ctd-template text="Click Save Asset."/>
                    <focus-ctd-template text="Select the Associate Users and Custodians action."/>
                    <focus-ctd-template text="Verify the error for invalid users and custodians."/>
                    <focus-ctd-template text="Select the Swap Depreciation Schedule action."/>
                    <focus-ctd-template text="Enter &quot;invalidasset&quot; in the Target Asset field."/>
                    <focus-ctd-template text="Click OK."/>
                </focus-ctd-multiple-template-testSteps>
