            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Log in to the Maximo Manage application."/>
                    <focus-ctd-template text="Navigate to the Assets application."/>
                    <focus-ctd-template text="Create a new rotating asset with the asset description &quot;anytext&quot;, rotating item &quot;no&quot;, parent asset &quot;anyasset&quot;, location &quot;anylocation&quot;, and status &quot;notapplicable&quot;."/>
                    <focus-ctd-template text="Associate &quot;anyservice&quot; with the asset using the Associate Services action."/>
                    <focus-ctd-template text="Change the status of the asset to &quot;decommissioned&quot; using the Change Status action."/>
                    <focus-ctd-template text="Select the transaction type as &quot;return_value&quot; and specify the site as &quot;anysite&quot;."/>
                    <focus-ctd-template text="Add a meter to the asset with meter type &quot;continuous&quot;, average calculation method &quot;slidingdays&quot;, and reading type &quot;actual&quot;."/>
                    <focus-ctd-template text="Add a depreciation schedule to the asset using the Manage Depreciation Schedule action."/>
                    <focus-ctd-template text="Select the depreciation method as &quot;doubledeclining&quot; and period type as &quot;meter&quot;."/>
                    <focus-ctd-template text="Save the depreciation schedule."/>
                    <focus-ctd-template text="Enter a meter reading for the asset using the Enter Meter Readings action."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The Maximo Manage application is displayed."/>
                    <focus-ctd-template text="The Assets application is displayed."/>
                    <focus-ctd-template text="A new asset is created with the specified details."/>
                    <focus-ctd-template text="The service &quot;anyservice&quot; is associated with the asset."/>
                    <focus-ctd-template text="The status of the asset is changed to &quot;decommissioned&quot;."/>
                    <focus-ctd-template text="The transaction type is set to &quot;return_value&quot; and the site is set to &quot;anysite&quot;."/>
                    <focus-ctd-template text="A meter is added to the asset with the specified details."/>
                    <focus-ctd-template text="The Manage Depreciation Schedule dialog box is displayed."/>
                    <focus-ctd-template text="The depreciation schedule is saved with the specified details."/>
                    <focus-ctd-template text="The depreciation schedule is updated."/>
                    <focus-ctd-template text="The meter reading is entered successfully."/>
                </focus-ctd-multiple-template-expectedResults>
