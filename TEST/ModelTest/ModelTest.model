                    <focus-ctd-template text="The system updates the asset status to &quot;decommissioned&quot;."/>
                    <focus-ctd-template text="The system displays an error message indicating that the target parent &quot;invalidasset&quot; is not valid."/>
                    <focus-ctd-template text="The system saves the asset record."/>
                    <focus-ctd-template text="The system displays the Associate Users and Custodians window."/>
