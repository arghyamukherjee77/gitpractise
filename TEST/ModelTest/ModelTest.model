            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Log in to the Maximo Manage application with a user account that has the necessary permissions."/>
                    <focus-ctd-template text="Navigate to the Assets application."/>
                    <focus-ctd-template text="Search for and select an asset."/>
                    <focus-ctd-template text="Select the &quot;Issue Items from Storeroom&quot; action."/>
                    <focus-ctd-template text="In the &quot;Issue Items from Storeroom&quot; window, specify a valid storeroom."/>
                    <focus-ctd-template text="In the &quot;Associated Items&quot; table, click &quot;New Row.&quot;"/>
                    <focus-ctd-template text="In the &quot;Item&quot; field, specify a valid item."/>
                    <focus-ctd-template text="In the &quot;Storeroom&quot; field, specify the storeroom selected in step 5."/>
                    <focus-ctd-template text="In the &quot;Quantity&quot; field, enter a valid quantity."/>
                    <focus-ctd-template text="In the &quot;Transaction Type&quot; field, select &quot;ISSUE.&quot;"/>
                    <focus-ctd-template text="Click &quot;OK&quot; to issue the item."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The system displays the Assets application homepage."/>
                    <focus-ctd-template text="The system displays the asset record."/>
                    <focus-ctd-template text="The system displays the &quot;Issue Items from Storeroom&quot; window."/>
                    <focus-ctd-template text="The system displays the &quot;Issue Items from Storeroom&quot; window with the specified storeroom."/>
                    <focus-ctd-template text="The system allows the user to add a new item row in the &quot;Associated Items&quot; table."/>
                    <focus-ctd-template text="The system populates the &quot;Item&quot; field with the specified item."/>
                    <focus-ctd-template text="The system populates the &quot;Storeroom&quot; field with the specified storeroom."/>
                    <focus-ctd-template text="The system populates the &quot;Quantity&quot; field with the entered quantity."/>
                    <focus-ctd-template text="The system sets the &quot;Transaction Type&quot; field to &quot;ISSUE.&quot;"/>
                    <focus-ctd-template text="The system issues the item to the asset and updates the asset record."/>
                    <focus-ctd-template text="The system displays a success message or confirmation of the item issuance."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>
            </focus-ctd-multiple-template>
