            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Log in to the Assets application."/>
                    <focus-ctd-template text="Click the New Asset icon on the toolbar."/>
                    <focus-ctd-template text="Enter &quot;anytext&quot; in the Asset Description field."/>
                    <focus-ctd-template text="Leave the Rotating Item field as &quot;notapplicable&quot;."/>
                    <focus-ctd-template text="Enter &quot;anyasset&quot; in the Parent field."/>
                    <focus-ctd-template text="Enter &quot;anylocation&quot; in the Location field."/>
                    <focus-ctd-template text="Select &quot;decommissioned&quot; as the Status."/>
                    <focus-ctd-template text="Select &quot;doubledeclining&quot; as the Depreciation Schedule."/>
                    <focus-ctd-template text="Select &quot;meter&quot; as the Period Type."/>
                    <focus-ctd-template text="Enter &quot;invaliduser&quot; in the Associated Users field."/>
                    <focus-ctd-template text="Enter &quot;anycustodian&quot; in the Associated Custodians field."/>
                    <focus-ctd-template text="Select &quot;notready&quot; as the New Status."/>
                    <focus-ctd-template text="Enter &quot;anysite&quot; in the To Site field."/>
                    <focus-ctd-template text="Enter &quot;anylocation&quot; in the To Location field."/>
                    <focus-ctd-template text="Enter &quot;anyasset&quot; in the To Parent field."/>
                    <focus-ctd-template text="Enter &quot;invalidmetertype&quot; in the Meter Type field."/>
                    <focus-ctd-template text="Select &quot;slidingreadings&quot; as the Average Calculation Method."/>
                    <focus-ctd-template text="Select &quot;delta&quot; as the Reading Type."/>
                    <focus-ctd-template text="Enter &quot;anydowntimecode&quot; in the Downtime Code field."/>
                    <focus-ctd-template text="Select &quot;nonoperational&quot; as the Downtime Type."/>
                    <focus-ctd-template text="Enter &quot;invalid&quot; in the Depreciation Method field."/>
                    <focus-ctd-template text="Click Save Asset."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The system displays the New Asset screen."/>
                    <focus-ctd-template text="The system populates the Asset Description field with &quot;anytext&quot;."/>
                    <focus-ctd-template text="The system leaves the Rotating Item field blank."/>
                    <focus-ctd-template text="The system populates the Parent field with &quot;anyasset&quot;."/>
                    <focus-ctd-template text="The system populates the Location field with &quot;anylocation&quot;."/>
                    <focus-ctd-template text="The system sets the Status to &quot;decommissioned&quot;."/>
                    <focus-ctd-template text="The system sets the Depreciation Schedule to &quot;doubledeclining&quot;."/>
                    <focus-ctd-template text="The system sets the Period Type to &quot;meter&quot;."/>
                    <focus-ctd-template text="The system displays an error message for the invalid user &quot;invaliduser&quot;."/>
                    <focus-ctd-template text="The system populates the Associated Custodians field with &quot;anycustodian&quot;."/>
                    <focus-ctd-template text="The system sets the New Status to &quot;notready&quot;."/>
                    <focus-ctd-template text="The system displays an error message indicating that the status change is not allowed for a decommissioned asset."/>
                    <focus-ctd-template text="The system populates the To Site field with &quot;anysite&quot;."/>
                    <focus-ctd-template text="The system populates the To Location field with &quot;anylocation&quot;."/>
                    <focus-ctd-template text="The system populates the To Parent field with &quot;anyasset&quot;."/>
                    <focus-ctd-template text="The system displays an error message for the invalid meter type &quot;invalidmetertype&quot;."/>
                    <focus-ctd-template text="The system sets the Average Calculation Method to &quot;slidingreadings&quot;."/>
                    <focus-ctd-template text="The system sets the Reading Type to &quot;delta&quot;."/>
                    <focus-ctd-template text="The system populates the Downtime Code field with &quot;anydowntimecode&quot;."/>
                    <focus-ctd-template text="The system sets the Downtime Type to &quot;nonoperational&quot;."/>
                    <focus-ctd-template text="The system saves the asset record despite the invalid depreciation method."/>
                    <focus-ctd-template text="The system displays a confirmation message that the asset record has been saved."/>
