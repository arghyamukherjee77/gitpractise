                    <focus-ctd-template text="Log in to the Assets application."/>
                    <focus-ctd-template text="Click the New Asset icon on the toolbar."/>
                    <focus-ctd-template text="Enter &quot;anytext&quot; in the Asset Description field."/>
                    <focus-ctd-template text="Select &quot;no&quot; in the Rotating Item field."/>
                    <focus-ctd-template text="Enter &quot;invalidlocation&quot; in the Location field."/>
                    <focus-ctd-template text="Select &quot;operational&quot; as the Status."/>
                    <focus-ctd-template text="Enter &quot;invalidschedule&quot; in the Depreciation Schedule field."/>
                    <focus-ctd-template text="Choose &quot;date&quot; as the Period Type."/>
                    <focus-ctd-template text="Select &quot;anyuser&quot; in the Associated Users field."/>
                    <focus-ctd-template text="Select &quot;anycustodian&quot; in the Associated Custodians field."/>
                    <focus-ctd-template text="Enter &quot;invalidservice&quot; in the Associated Services field."/>
                    <focus-ctd-template text="Choose &quot;slidingdays&quot; as the Average Calculation Method."/>
                    <focus-ctd-template text="Select &quot;delta&quot; as the Reading Type."/>
                    <focus-ctd-template text="Choose &quot;nonoperational&quot; as the Downtime Type."/>
                    <focus-ctd-template text="Select &quot;anyasset&quot; in the Replacing Asset field."/>
                    <focus-ctd-template text="Enter &quot;invalid&quot; in the Depreciation Method field."/>
                    <focus-ctd-template text="Click Save Asset."/>
                </focus-ctd-multiple-template-testSteps>
