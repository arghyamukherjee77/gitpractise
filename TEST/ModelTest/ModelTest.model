        <focus-ctd-trigger appliance="ALWAYS" is_or="false" name="test step-1" negative="false" suppressNewLine="false" triggerType="Test_Steps">
            <focus-ctd-multiple-template>
                <focus-ctd-multiple-template-testSteps>
                    <focus-ctd-template text="Navigate to the Assets application and select the rotating asset to be issued."/>
                    <focus-ctd-template text="Select the &quot;Issue Items from Storeroom&quot; action."/>
                    <focus-ctd-template text="In the &quot;Issue Items from Storeroom&quot; window, specify a valid storeroom."/>
                    <focus-ctd-template text="In the &quot;Associated Items&quot; table, add a new row and specify the rotating asset item."/>
                    <focus-ctd-template text="Set the &quot;Transaction Type&quot; to &quot;ISSUE&quot;."/>
                    <focus-ctd-template text="Enter &quot;anyuser&quot; in the associated user field."/>
                    <focus-ctd-template text="Enter &quot;invalidcustodian&quot; in the custodian field."/>
                    <focus-ctd-template text="Enter &quot;invalidservice&quot; in the associated services field."/>
                    <focus-ctd-template text="Specify &quot;anysite&quot; as the &quot;To Site&quot;."/>
                    <focus-ctd-template text="Specify &quot;anylocation&quot; as the &quot;To Location&quot;."/>
                    <focus-ctd-template text="Click &quot;OK&quot; to complete the transaction."/>
                </focus-ctd-multiple-template-testSteps>
                <focus-ctd-multiple-template-expectedResults>
                    <focus-ctd-template text="The system displays the rotating asset details."/>
                    <focus-ctd-template text="The &quot;Issue Items from Storeroom&quot; window is displayed."/>
                    <focus-ctd-template text="The storeroom is set to the specified valid storeroom."/>
                    <focus-ctd-template text="The rotating asset item is added to the &quot;Associated Items&quot; table."/>
                    <focus-ctd-template text="The &quot;Transaction Type&quot; is set to &quot;ISSUE&quot;."/>
                    <focus-ctd-template text="The associated user is set to &quot;anyuser&quot;."/>
                    <focus-ctd-template text="An error message or validation message is displayed for the invalid custodian."/>
                    <focus-ctd-template text="An error message or validation message is displayed for the invalid service."/>
                    <focus-ctd-template text="The &quot;To Site&quot; is set to &quot;anysite&quot;."/>
                    <focus-ctd-template text="The &quot;To Location&quot; is set to &quot;anylocation&quot;."/>
                    <focus-ctd-template text="A validation message is displayed indicating the successful issuance or any errors due to invalid custodian or service."/>
                </focus-ctd-multiple-template-expectedResults>
                <focus-ctd-multiple-template-additionalInfo/>
            </focus-ctd-multiple-template>
